---
import Base from '../layouts/Base.astro';
import { profile, projects, ui, projectUrl, type Lang } from '../data/content';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = ui[lang];
const p = projects.find((x) => x.slug === slug)!;
const otherLang: Lang = lang === 'en' ? 'de' : 'en';
const homeUrl = lang === 'en' ? '/' : '/de/';
// always show at least two image slots so there is room for screenshots
const slots = p.images.length > 0 ? p.images : ['', ''];
---

<Base
  lang={lang}
  title={`${p.title} — ${profile.name}`}
  description={p.summary[lang]}
  alternateUrl={projectUrl(p.slug, otherLang)}
>
  <article class="wrap project">
    <a class="back" href={`${homeUrl}#projects`}>{t.backHome}</a>
    <p class="kicker">{t.nav.projects}</p>
    <h1>{p.title}</h1>
    <p class="summary">{p.summary[lang]}</p>

    {p.tech.length > 0 && (
      <div class="meta">
        <span class="label">{t.techUsed}</span>
        <div class="chips">{p.tech.map((x) => <span class="chip">{x}</span>)}</div>
      </div>
    )}

    <div class="gallery">
      {slots.map((src, i) =>
        src
          ? <img src={src} alt={`${p.title} — ${i + 1}`} loading="lazy" />
          : <div class="slot"><span>{t.screenshotSoon}</span></div>
      )}
    </div>

    <div class="text">
      {p.description[lang].map((para) => <p>{para}</p>)}
    </div>

    {p.links.length > 0 && (
      <div class="links">
        {p.links.map((l) => <a class="btn ghost" href={l.url} target="_blank" rel="noopener">{l.label[lang]} ↗</a>)}
      </div>
    )}
  </article>
</Base>

<style>
  .project { max-width: 860px; padding: 48px 0 80px; }
  .back { display: inline-block; margin-bottom: 36px; text-decoration: none; color: var(--ink-soft); font-size: .92rem; }
  .back:hover { color: var(--ink); }
  .kicker { border: 0; padding: 0; margin-bottom: 8px; color: var(--accent); }
  h1 { font-family: var(--serif); font-size: clamp(2.2rem, 5vw, 3.2rem); line-height: 1.1; margin: 0 0 12px; font-weight: 600; }
  .summary { font-size: 1.2rem; color: var(--ink-soft); margin: 0 0 24px; }
  .meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
  .label { font-size: .8rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 8px 0 36px; }
  .gallery img, .slot { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .slot { display: grid; place-items: center; background: var(--sand-faint); border: 1.5px dashed var(--sand); color: var(--accent); font-size: .85rem; letter-spacing: .05em; }
  .text p { font-size: 1.08rem; margin: 0 0 1.1em; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
</style>
